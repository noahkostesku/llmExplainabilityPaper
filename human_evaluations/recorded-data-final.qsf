d*\/\n\n});"}},{"SurveyID":"SV_b7M9HGkYYZDWWaO","Element":"SQ","PrimaryAttribute":"QID32","SecondaryAttribute":"${setEmbeddedData(\"seenModels\", \"${e:\/\/Field\/seenModels}${e:\/\/Field\/seenModels == \"\" ? \"\" : \",\"}$...","TertiaryAttribute":null,"Payload":{"QuestionText":"${setEmbeddedData(\"seenModels\", \"${e:\/\/Field\/seenModels}${e:\/\/Field\/seenModels == \"\" ? \"\" : \",\"}${e:\/\/Field\/modelAssign}","DefaultChoices":false,"DataExportTag":"Q32","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"${setEmbeddedData(\"seenModels\", \"${e:\/\/Field\/seenModels}${e:\/\/Field\/seenModels == \"\" ? \"\" : \",\"}$...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID32"}},{"SurveyID":"SV_b7M9HGkYYZDWWaO","Element":"SQ","PrimaryAttribute":"QID33","SecondaryAttribute":"Click to write the question text","TertiaryAttribute":null,"Payload":{"QuestionText":"Click to write the question text","DefaultChoices":false,"DataExportTag":"Q33","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Click to write the question text","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID33","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function() {\n    \/\/ Skip if model already assigned (e.g., going backward in survey)\n    if (\"${e:\/\/Field\/modelAssign}\") return;\n\n    \/\/ Get seen models (split into array, filter empties)\n    const seen = \"${e:\/\/Field\/seenModels}\".split(\",\").filter(m => m.trim() !== \"\");\n    \n    \/\/ Randomly pick from remaining models (A\/B\/C not in 'seen')\n    const available = [\"A\", \"B\", \"C\"].filter(model => !seen.includes(model));\n    const selected = available[Math.floor(Math.random() * available.length)];\n    \n    \/\/ Store selection for your branches to use\n    Qualtrics.SurveyEngine.setEmbeddedData(\"modelAssign\", selected);\n    Qualtrics.SurveyEngine.setEmbeddedData(\"seenModels\", \n        seen.length > 0 ? `${seen.join(\",\")},${selected}` : selected);\n});\n\nQualtrics.SurveyEngine.addOnReady(function()\n{\n\t\/*Place your JavaScript here to run when the page is fully displayed*\/\n\n});\n\nQualtrics.SurveyEngine.addOnUnload(function()\n{\n\t\/*Place your JavaScript here to run when the page is unloaded*\/\n\n});"}},{"SurveyID":"SV_b7M9HGkYYZDWWaO","Element":"SQ","PrimaryAttribute":"QID34","SecondaryAttribute":"DEBUG: JS Executed: ${e:\/\/Field\/jsRan} Model: ${e:\/\/Field\/modelAssign} Seen: ${e:\/\/Field\/seenModels}","TertiaryAttribute":null,"Payload":{"QuestionText":"DEBUG:\nJS Executed: ${e:\/\/Field\/jsRan}\nModel: ${e:\/\/Field\/modelAssign}\nSeen: ${e:\/\/Field\/seenModels}","DefaultChoices":false,"DataExportTag":"Q34","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"DEBUG: JS Executed: ${e:\/\/Field\/jsRan} Model: ${e:\/\/Field\/modelAssign} Seen: ${e:\/\/Field\/seenModels}","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID34","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function() {\n    \/* Initialize seenModels if empty *\/\n    if (\"${e:\/\/Field\/seenModels}\" === \"undefined\") {\n        Qualtrics.SurveyEngine.setEmbeddedData(\"seenModels\", \"\");\n    }\n    \n    \/* Only assign if model not already set *\/\n    if (!\"${e:\/\/Field\/modelAssign}\" || \"${e:\/\/Field\/modelAssign}\" === \"undefined\") {\n        const seen = (\"${e:\/\/Field\/seenModels}\" || \"\").split(\",\").filter(Boolean);\n        const available = [\"A\", \"B\", \"C\"].filter(m => !seen.includes(m));\n        \n        if (available.length > 0) {\n            const selected = available[Math.floor(Math.random() * available.length)];\n            Qualtrics.SurveyEngine.setEmbeddedData(\"modelAssign\", selected);\n            Qualtrics.SurveyEngine.setEmbeddedData(\"seenModels\", \n                seen.length ? seen + \",\" + selected : selected);\n            \n            \/* Force page refresh to update embedded data *\/\n            Qualtrics.SurveyEngine.setEmbeddedData(\"jsRan\", \"1\");\n            setTimeout(() => this.clickNextButton(), 100);\n        }\n    }\n});\n\nQualtrics.SurveyEngine.addOnReady(function()\n{\n\t\/*Place your JavaScript here to run when the page is fully displayed*\/\n\n});\n\nQualtrics.SurveyEngine.addOnUnload(function()\n{\n\t\/*Place your JavaScript here to run when the page is unloaded*\/\n\n});"}},{"SurveyID":"SV_b7M9HGkYYZDWWaO","Element":"SQ","PrimaryAttribute":"QID35","SecondaryAttribute":"Click to write the question text","TertiaryAttribute":null,"Payload":{"QuestionText":"Click to write the question text","DefaultChoices":false,"DataExportTag":"Q35","QuestionType":"TE","Selector":"ML","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Click to write the question text","Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionID":"QID35","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function() {\n  var seen = \"${e:\/\/Field\/seenModels}\";\n  var currentModel = \"${e:\/\/Field\/modelAssign}\";\n\n  if (seen === \"\") {\n    Qualtrics.SurveyEngine.setEmbeddedData(\"seenModels\", currentModel);\n  } else {\n    if (!seen.split(\",\").includes(currentModel)) {\n      Qualtrics.SurveyEngine.setEmbeddedData(\"seenModels\", seen + \",\" + currentModel);\n    }\n  }\n});\n\n\nQualtrics.SurveyEngine.addO