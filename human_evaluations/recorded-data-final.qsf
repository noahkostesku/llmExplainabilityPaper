This explanation provides sufficient evidence for a loan decision.<br><br>\n\n<b>Insightfulness<\/b>:&nbsp;This explanation reveals meaningful risk factors that influence loan decisions.<br><br>\n\n<b>Satisfaction<\/b>:&nbsp;The level of detail meets my expectations for a risk assessment.<br><br>\n\n<b>Confidence<\/b>:&nbsp;This explanation increases my confidence in the decision for loan default.<br><br>\n\n<b>Convincingness<\/b>:&nbsp;The justification persuasively argues for the decision using well-weighted risk evidence.<br><br>\n\n<b>Communicability<\/b>:&nbsp;I could use this explanation to communicate with customers and other teams in the company<br><br>\n\n<b>Usability<\/b>:&nbsp;This explanation could be directly used in loan approval documentation.<br>","DefaultChoices":false,"DataExportTag":"Q14","QuestionType":"Matrix","Selector":"Likert","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","ChoiceColumnWidth":25,"RepeatHeaders":"none","WhiteSpace":"OFF","MobileFirst":true,"ChoiceColumnWidthPixels":128},"QuestionDescription":"Now, rate the following metrics on a scale from 1 (Strongly Disagree) to 5 (Strongly Agree) and e...","Choices":{"1":{"Display":"Understandability"},"2":{"Display":"Trustworthiness"},"3":{"Display":"Insightfulness"},"4":{"Display":"Satisfaction"},"5":{"Display":"Confidence"},"6":{"Display":"Convincingness"},"7":{"Display":"Communicability"},"8":{"Display":"Usability"}},"ChoiceOrder":[1,2,3,4,5,6,7,8],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":9,"NextAnswerId":6,"Answers":{"1":{"Display":"1"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"}},"AnswerOrder":[1,2,3,4,5],"ChoiceDataExportTags":false,"QuestionID":"QID14","AnswerColumns":3,"SubSelector":"SingleAnswer"}},{"SurveyID":"SV_b7M9HGkYYZDWWaO","Element":"SQ","PrimaryAttribute":"QID140",