ion":"Communicability:\u00a0The explanation is clear enough for me to communicate it to others.","Choices":{"1":{"Display":"1 - Strongly Disagree"},"2":{"Display":"2 - Slightly Disagree"},"3":{"Display":"3 - Neutral"},"4":{"Display":"4 - Slightly Agree"},"5":{"Display":"5 - Strongly Agree"},"6":{"Display":"Unsure\/Prefer not to answer"}},"ChoiceOrder":[1,2,3,4,5,6],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":7,"NextAnswerId":1,"QuestionID":"QID120","DisplayLogic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID208\/SelectableChoice\/2","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">Would you like to do another round?\n (All Loops)<\/span> <span class=\"LeftOpDesc\">No<\/span> <span class=\"OpDesc\">Is Not Selected<\/span> ","FunctionName":"evaluateAllInArrayFunction","LeftOperand":"q:\/\/QID208\/SelectableChoice\/2","LogicType":"Question","LoopAndMergeLoops":"BL_6gv9fJOGIdExp9s,all","LoopTarget":"evaluateAllInArrayFunction","Operator":"NotSelected","QuestionID":"QID208","QuestionIDFromLocator":"QID208","QuestionIsInLoop":"yes","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression","inPage":false}}},{"SurveyID":"SV_b7M9HGkYYZDWWaO","Element":"SQ","PrimaryAttribute":"QID121","SecondaryAttribute":"Usability: I am likely to use this explanation in the future because it is usable and supports my...","TertiaryAttribute":null,"Payload":{"QuestionText":"<b>Usability<\/b>: I am likely to use this explanation in the future because it is usable and supports my decision-making.<br>\n","DefaultChoices":false,"DataExportTag":"Q121","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Usability: I am likely to use this explanation in the future because it is usable and supports my...","Choices":{"1":{"Display":"1 - Strongly Disagree"},"2":{"Display":"2 - Slightly Disagree"},"3":{"Display":"3 - Neutral"},"4":{"Display":"4 - Slightly Agree"},"5":{"Display":"5 - Strongly Agree"},"6":{"Display":"Unsure\/Prefer not to answer"}},"ChoiceOrder":[1,2,3,4,5,6],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":7,"NextAnswerId":1,"QuestionID":"QID121","DisplayLogic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID208\/SelectableChoice\/2","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">Would you like to do another round?\n (All Loops)<\/span> <span class=\"LeftOpDesc\">No<\/span> <span class=\"OpDesc\">Is Not Selected<\/span> ","FunctionName":"evaluateAllInArrayFunction","LeftOperand":"q:\/\/QID208\/SelectableChoice\/2","LogicType":"Question","LoopAndMergeLoops":"BL_6gv9fJOGIdExp9s,all","LoopTarget":"evaluateAllInArrayFunction","Operator":"NotSelected","QuestionID":"QID208","QuestionIDFromLocator":"QID208","QuestionIsInLoop":"yes","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression","inPage":false}}},{"SurveyID":"SV_b7M9HGkYYZDWWaO","Element":"SQ","PrimaryAttribute":"QID122","SecondaryAttribute":"Click to write the question text","TertiaryAttribute":null,"Payload":{"QuestionText":"Click to write the question text","DefaultChoices":false,"DataExportTag":"Q122","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Click to write the question text","Choices":{"1":{"Display":"Click to write Choice 1"},"2":{"Display":"Click to write Choice 2"},"3":{"Display":"Click to write Choice 3"}},"ChoiceOrder":["1","2","3"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID122"}},{"SurveyID":"SV_b7M9HGkYYZDWWaO","Element":"SQ","PrimaryAttribute":"QID123","SecondaryAttribute":"Click to write the question text","TertiaryAttribute":null,"Payload":{"QuestionText":"Click to write the question text","DefaultChoices":false,"DataExportTag":"Q123","QuestionType":"TE","Selector":"ML","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Click to write the question text","Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionID":"QID123"}},{"SurveyID":"SV_b7M9HGkYYZDWWaO","Element":"SQ","PrimaryAttribute":"QID124","SecondaryAttribute":"Study Title: Evaluating Large Language Model Explanations in Credit Risk Purpose of the Study: Yo...","TertiaryAttribute":null,"Payload":{"QuestionText":"<b>Study Title:<\/b> Evaluating Large Language Model Explanations in Credit Risk  \n<br><br>\n\n<b>Purpose of the Study:<\/b> You are invited to participate in a research study that explores how people evaluate AI-generated explanations of borrower credit risk predictions.  \n\n<br><br>\n\n<b>Procedures:<\/b> You will review four AI-generated credit risk explanations and rate them on qualities such as trust, clarity, and insight. The survey consists of one required round, with up to two additional optional rounds (3 rounds total). Each round includes 4 explanations. You may exit the survey after any round. The total duration is approximately 10\u201315 minutes.\n\n<br><br>\n\n<b>Risks and Benefits:<\/b> There are no anticipated risks beyond those experienced in everyday life. While there are no direct benefits to you, your participation will help researchers better understand how people interpret AI-generated decisions.\n\n<br><br>\n\n<b>Confidentiality:<\/b> This study is anonymous. No identifying information will be collected unless you voluntarily provide optional demographic details at the end. All responses will remain confidential and used only for research purposes.\n\n<br><br>\n\n<b>Voluntary Participation:<\/b> Participation is entirely voluntary. You may stop after completing any round without penalty.\n\n<br><br>\n\n<b>Contact for Questions:<\/b> If you have questions about the study, please contact the researcher: Sahab Zandi at <a href=\"mailto:szandi@uwo.ca\">szandi@uwo.ca<\/a>.\n\n<br><br>\n\n<b>Consent:<\/b> By clicking \u201cYes\u201d to begin, you confirm that you consent to participate in this anonymous research study. Clicking \u201cNo\u201d will exit the survey.\n","DefaultChoices":false,"DataExportTag":"Q124","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Study Title: Evaluating Large Language Model Explanations in Credit Risk Purpose of the Study: Yo...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID124"}},{"SurveyID":"SV_b7M9HGkYYZDWWaO","Element":"SQ","PrimaryAttribute":"QID125","SecondaryAttribute":"Letter of Information and Consent Western University; Department of Statistical and Actuarial Sci...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: center; font-weight: bold;\"><h2 style=\"margin-top: 0;\">Letter of Information and Consent<\/h2><\/div><br><strong>Western University<\/strong>;<br><strong>Department of Statistical and Actuarial Sciences <\/strong><br><strong>Department of Computer Science<\/strong> <br><br><strong>Study Title:<\/strong><br>Evaluating Large Language Model Explanations in Credit Risk<br><br><strong>Principal Investigator:<\/strong><br>Dr. Cristi\u00e1n Bravo Roman, PhD<br>Professor, Canada Research Chair in Banking and Insurance Analytics<br>Department of Statistical and Actuarial Sciences<br>Western University<br><a data-cke-saved-href=\"mailto:cbravoro@uwo.ca\" href=\"mailto:cbravoro@uwo.ca\" style=\"color:blue; text-decoration:underline;\">cbravoro@uwo.ca<\/a><br><br><strong>Student Researchers:<\/strong><br>Sahab Zandi, PhD Candidate<br>Department of Statistical and Actuarial Sciences<br>Western University<br><a data-cke-saved-href=\"mailto:szandi@uwo.ca\" href=\"mailto:szandi@uwo.ca\" style=\"color:blue; text-decoration:underline;\">szandi@uwo.ca<\/a><br><br>Noah Kostesku, HBSc Candidate<br>Department of&nbsp;Computer Science<br>Western University<br><a data-cke-saved-href=\"mailto:nkostes@uwo.ca\" href=\"mailto:nkostes@uwo.ca\" style=\"color:blue; text-decoration:underline;\">nkostes@uwo.ca<\/a><br><br><strong>Introduction<\/strong><br>This study examines how people evaluate AI-generated explanations for approval or denial of loan applications.<br><br><strong>Background and Purpose of the Study<\/strong><br>AI systems are increasingly being used in credit risk assessment for loan applications, where fairness, transparency, and trust are critical. While these systems generate explanations for their decisions, little is known about how users perceive different explanation types.<br><br>This study evaluates explanation styles based on understandability, clarity, trustworthiness, and satisfaction. By collecting user ratings across formats, it identifies which approaches best support user comprehension and confidence in AI-driven credit decisions.<br><br><strong>What Will Happen During the Study<\/strong><br>You will review AI-generated credit risk explanations and rate them on qualities such as understandability, trustworthiness, and insightfulness. The survey consists of one required round, with up to two additional optional rounds (3 rounds total). Each round includes 4 explanations. Explanation types are assigned at random. The duration is approximately 5\u201310 minutes per round.<br><br>This online study is hosted on Qualtrics. You can review the privacy policy here: <a rel=\"noopener\" data-cke-saved-href=\"https:\/\/www.qualtrics.com\/privacy-statement\/\" href=\"https:\/\/www.qualtrics.com\/privacy-statement\/\" target=\"_blank\">https:\/\/www.qualtrics.com\/privacy-statement\/<\/a>.<br><br><strong>Inclusion Criteria<\/strong><br>You must be 18 years of age or older to participate. There are no other inclusion or exclusion criteria.<br><br><strong>Risks and Benefits<\/strong><br>There are no known or anticipated risks associated with this study beyond those experienced in everyday life. While there are no direct benefits to you, your participation will help researchers better understand how individuals interpret AI-generated explanations in financial decision-making contexts.<br><br><strong>Confidentiality<\/strong><br>This study is anonymous. Responses cannot be linked to individuals, though you may optionally provide demographic information at the end. All responses will remain confidential and used solely for research. Results will be reported in aggregate and may appear in academic publications or a thesis.<br><br>Survey data will be securely stored on Qualtrics and may be accessed by authorized representatives of Western University\u2019s ethics board for oversight. It will not be shared for open access or future research and will be destroyed after the study concludes. Within 1\u20132 days of survey closure, all data will be transferred to a secure Western University server, where it will be stored for a minimum of 5 years. Once the transfer is verified, data will be permanently deleted from Qualtrics. After the 5-year retention period, data will be securely destroyed.<br><br>To protect the quality and integrity of the data, the survey includes automated bot detection, reCAPTCHA, and attention checks. Responses that appear to be submitted by bots or that fail these checks may be excluded from analysis. No identifiable information is collected as part of this review process.\n<br><br><strong>Voluntary Participation and Withdrawal<\/strong><br>Your participation in this study is entirely voluntary. You may choose not to answer any question and may exit the survey after completing any round, before submitting your responses. Due to the anonymous nature of the data, once a round has been submitted, the responses from that round cannot be withdrawn. You do not waive any legal rights by participating in this study. You will not be re-contacted with updates or additional information during the course of the study.<br><br><strong>Compensation<\/strong><br>You will not be compensated for your participation in this study.<br><br><strong>Contact Information<\/strong><br>If you have questions about the study, please contact: Sahab Zandi at <a data-cke-saved-href=\"mailto:szandi@uwo.ca\" href=\"mailto:szandi@uwo.ca\" style=\"color:blue; text-decoration:underline;\">szandi@uwo.ca<\/a>.<br><br>If you have any questions about your rights as a research participant or the conduct of this study, you may contact: <br><br>The Office of Human Research Ethics \n<br>Phone: (519) 661-3036 or 1-844-720-9816 <br><a data-cke-saved-href=\"mailto:ethics@uwo.ca\" href=\"mailto:ethics@uwo.ca\" style=\"color:blue; text-decoration:underline;\">ethics@uwo.ca<\/a> <br><br>This office oversees the ethical conduct of research studies and is not part of the study team. Everything that you discuss will be kept confidential. <br><br><strong>Consent<\/strong><br>By clicking \"Yes\", you confirm that:<br><br><ul><li>You are 18 years of age or older.<\/li><li>You have read and understood the information above.<\/li><li>You consent to participate in this anonymous research study.<\/li><br><\/ul> Clicking \"No\" will exit the survey.","DefaultChoices":false,"DataExportTag":"Q125","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","Autoscale":{"YScale":{"Name":"yesNo","Type":"likert","Reverse":true}},"LabelPosition":"BELOW"},"QuestionDescription":"Letter of Information and Consent Western University; Department of Statistical and Actuarial Sci...","Choices":{"1":{"Display":"Yes"},"2":{"Display":"No"}},"ChoiceOrder":[1,2],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":3,"NextAnswerId":1,"QuestionID":"QID125"}},{"SurveyID":"SV_b7M9HGkYYZDWWaO","Element":"SQ","PrimaryAttribute":"QID126","SecondaryAttribute":"What is your age group?","TertiaryAttribute":null,"Payload":{"QuestionText":"What is your age group?","DefaultChoices":false,"DataExportTag":"Q126","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"What is your age group?","Choices":{"2":{"Display":"18 - 24"},"3":{"Display":"25 - 34"},"4":{"Display":"35 - 44"},"5":{"Display":"45 - 54"},"6":{"Display":"55 - 64"},"7":{"Display":"65 or older"},"8":{"Display":"Prefer not to say"}},"ChoiceOrder":[2,3,4,5,6,7,8],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":9,"NextAnswerId":1,"QuestionID":"QID126","DisplayLogic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID94\/SelectableChoice\/1","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">Would you like to answer a few optional demographic questions?\n\nNote: No personally identifying information will be collected.<\/span> <span class=\"LeftOpDesc\">Yes<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID94\/SelectableChoice\/1","LogicType":"Question","Operator":"Selected","QuestionID":"QID94","QuestionIDFromLocator":"QID94","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression","inPage":false}}},{"SurveyID":"SV_b7M9HGkYYZDWWaO","Element":"SQ","PrimaryAttribute":"QID127","SecondaryAttribute":"How would you describe your gender identity?","TertiaryAttribute":null,"Payload":{"QuestionText":"How would you describe your gender identity?","DefaultChoice