nID":"QID77"}},{"SurveyID":"SV_b7M9HGkYYZDWWaO","Element":"SQ","PrimaryAttribute":"QID78","SecondaryAttribute":"You have completed Round\u00a0${lm:\/\/CurrentLoopNumber}. \u00a0Thank you for completing our Survey!","TertiaryAttribute":null,"Payload":{"QuestionText":"You have completed Round&nbsp;${lm:\/\/CurrentLoopNumber}.<br><br>&nbsp;Thank you for completing our Survey!","DefaultChoices":false,"DataExportTag":"Q78","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"You have completed Round\u00a0${lm:\/\/CurrentLoopNumber}. \u00a0Thank you for completing our Survey!","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID78","DisplayLogic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID76\/SelectableChoice\/4","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">Would you like to do another round (max 3)? (All Loops)<\/span> <span class=\"LeftOpDesc\">No<\/span> <span class=\"OpDesc\">Is Not Selected<\/span> ","FunctionName":"evaluateAllInArrayFunction","LeftOperand":"q:\/\/QID76\/SelectableChoice\/4","LogicType":"Question","LoopAndMergeLoops":"BL_6FnQLSZ3lSFMcdw,all","LoopTarget":"evaluateAllInArrayFunction","Operator":"NotSelected","QuestionID":"QID76","QuestionIDFromLocator":"QID76","QuestionIsInLoop":"yes","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression","inPage":false}}},{"SurveyID":"SV_b7M9HGkYYZDWWaO","Element":"SQ","PrimaryAttribute":"QID79","SecondaryAttribute":"Task Overview: You\u2019ll review explanations generated by AI. Each one outlines a borrower\u2019s credit","TertiaryAttribute":null,"Payload":{"QuestionText":"<b>Task Overview:<\/b><br><br>\nYou\u2019ll review explanations generated by AI. Each one outlines a borrower\u2019s credit risk and provides a recommendation to approve or deny the loan application.<br><br>\n\nAfter reading each explanation, you will rate your level of agreement with several evaluation metrics using the following 5-point scale:\n<br><br>\n<ul>\n  <li>1 (Strongly Disagree)<\/li>\n  <li>2 (Slightly Disagree)<\/li>\n  <li>3 (Neutral)<\/li>\n  <li>4 (Slightly Agree)<\/li>\n  <li>5 (Strongly Agree)<\/li>\n<\/ul>\n<br><br>\nIn this round, you will evaluate four explanations. You may choose to continue with up to two additional rounds, for a total of 12 explanations.\n","DefaultChoices":false,"DataExportTag":"Q79","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Task Overview: You\u2019ll review explanations generated by AI. Each one outlines a borrower\u2019s credit...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID79"}},{"SurveyID":"SV_b7M9HGkYYZDWWaO","Element":"SQ","PrimaryAttribute":"QID8","SecondaryAttribute":"Task Overview: You will evaluate 4 AI-generated explanations of loan decisions. Each explains why...","TertiaryAttribute":null,"Payload":{"QuestionText":"<b>Task Overview<\/b>:  \nYou will evaluate 4 AI-generated explanations of loan decisions. Each explains why a model predicted a borrower\u2019s default risk and recommended approval\/denial.  \n<br><br>\n\n&nbsp;<b>LLM Output Example<\/b>:  \n\"Based on the borrower's credit history and current financial situation, there is a 30% chance they may default on this loan. While they have steady income of $5,500 a month, their high credit card debt compared to their income...\"  \n<br><br>\n\nAfter reading each explanation, rate how strongly you agree with each of the following 8 statements on a scale from 1 (Strongly Disagree) to 5 (Strongly Agree):  \n<br><br>\n\n<ul>\n  <li>Understandability<\/li>\n  <li>Trustworthiness<\/li>\n  <li>Insightfulness<\/li>\n  <li>Satisfaction<\/li>\n  <li>Confidence<\/li>\n  <li>Convincingness<\/li>\n  <li>Communicability<\/li>\n  <li>Usability<\/li>\n<\/ul>\n\n<br><br>\n<p>\nYou\u2019ll evaluate 4 explanations now. Optionally, you may complete up to 2 additional rounds (12 explanations total).<\/p>","DefaultChoices":false,"DataExportTag":"Q8","QuestionType":"TE","Selector":"ML","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","InputWidth":680,"InputHeight":104},"QuestionDescription":"Task Overview: You will evaluate 4 AI-generated explanations of loan decisions. Each explains why...","Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionID":"QID8"}},{"SurveyID":"SV_b7M9HGkYYZDWWaO","Element":"SQ","PrimaryAttribute":"QID80","SecondaryAttribute":"Please read the text below and evaluate it using the criteria provided: ${lm:\/\/Field\/2}","TertiaryAttribute":null,"Payload":{"QuestionText":"Please read the text below and evaluate it using the criteria provided:<br><br>\n<span style=\"border: 1px solid black; padding: 6px; background-color: #f5f5f5; display: inline-block;\">\n  ${lm:\/\/Field\/2}\n<\/span>\n<br><br>","DefaultChoices":false,"DataExportTag":"Q80","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Please read the text below and evaluate it using the criteria provided: ${lm:\/\/Field\/2}","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID80","DisplayLogic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID89\/SelectableChoice\/2","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">Would you like to complete another round (max 3)? (All Loops)<\/span> <span class=\"LeftOpDesc\">No<\/span> <span class=\"OpDesc\">Is Not Selecte